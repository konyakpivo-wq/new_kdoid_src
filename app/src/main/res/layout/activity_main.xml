<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Магазин приложений на основе GitHub"
        android:textSize="16sp" />

    <Button
        android:id="@+id/newAppsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/new_apps" />

    <Button
        android:id="@+id/appsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apps" />

    <Button
        android:id="@+id/utilitiesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/utilities" />

    <Button
        android:id="@+id/systemButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/system" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings" />
</LinearLayout>
